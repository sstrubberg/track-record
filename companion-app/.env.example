# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored - real tokens never get committed.

# https://www.discogs.com/settings/developers - personal access token
DISCOGS_TOKEN=

# Optional. TheAudioDB works without this using its free key (30 requests a
# minute); a premium key from https://www.theaudiodb.com/ raises the limit.
AUDIODB_API_KEY=

# https://console.anthropic.com/ - used by fetch/llm_web_search.py
ANTHROPIC_API_KEY=
