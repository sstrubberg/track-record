# Lexicon writes generated data files into this at runtime
lexicon-plugin/Files/

# Python
companion-app/**/__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
env/

# Secrets - real tokens go here, never committed. See .env.example.
companion-app/.env

# Local caches / generated review output - contains real library data
companion-app/**/*_cache.json
companion-app/**/*_plan.csv
companion-app/**/*_plan.json
companion-app/**/*_applied_log.json
companion-app/scan_progress.json
logs/

# billboard_tag.py's phase_load - raw dataset downloads it builds
# billboard_cache.json from (tens of MB, re-downloadable, not source)
companion-app/charts/dataset_*.csv
companion-app/charts/*.progress.json

# Downloaded model weights (~330 MB) - fetched on first use, not committed
companion-app/models/

# macOS
.DS_Store
